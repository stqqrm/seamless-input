# Writes a header with a build id that is the hash of everything under src/.
#
#   cmake -DSRC_DIR=<project>/src -DOUT=<build>/generated/seamless_build_id.hpp -P BuildId.cmake
#
# Run at every build (see CMakeLists.txt), so ANY change to the sources gives a new id and both PCs can
# tell whether they run the same code (see version.hpp). Only core CMake commands are used.
#   - line endings are normalised first: a Windows checkout (CRLF) and a Linux one (LF) of the same
#     code get the same id
#   - the file NAME is part of the hash, so renaming or moving a file counts as a change
#   - the header is only rewritten when the id changed, so an unchanged tree causes no recompilation

if(NOT SRC_DIR OR NOT OUT)
    message(FATAL_ERROR "BuildId.cmake: pass -DSRC_DIR=... and -DOUT=...")
endif()

# the same kinds of files the project compiles (see "Source discovery" in CMakeLists.txt)
file(GLOB_RECURSE files RELATIVE "${SRC_DIR}"
    "${SRC_DIR}/*.cpp" "${SRC_DIR}/*.cc" "${SRC_DIR}/*.c"
    "${SRC_DIR}/*.h" "${SRC_DIR}/*.hpp")
list(SORT files)

set(manifest "")
foreach(f IN LISTS files)
    file(READ "${SRC_DIR}/${f}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(REPLACE "\r" "\n" content "${content}")
    string(SHA256 fileHash "${content}")
    string(APPEND manifest "${f}:${fileHash}\n")
endforeach()

string(SHA256 all "${manifest}")
string(SUBSTRING "${all}" 0 8 id)

set(header "// Generated by cmake/BuildId.cmake. Do not edit.\n#pragma once\n#define SI_BUILD_ID \"${id}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL header)
    get_filename_component(outDir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${outDir}")
    file(WRITE "${OUT}" "${header}")
    message(STATUS "build id: ${id}")
endif()
